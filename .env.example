# Metabase Configuration
# Copy this file to .env and update with your actual values

# Metabase instance URL (required)
# Example: https://metabase.company.com
METABASE_URL=https://your-metabase-instance.com

# Metabase API Key (required)
# Generate this from your Metabase instance under Admin > People > API Keys
# The token should be in the format: mb_xxxxxxxxxx
METABASE_API_KEY=mb_your_api_key_here